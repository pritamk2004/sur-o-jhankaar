# =================================================================
# 🎵 SUR O JHANKAAR — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# =================================================================

# Server Settings
NODE_ENV=production
PORT=5000
CLIENT_URL=http://localhost:3000

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/sur_o_jhankaar
REDIS_URL=redis://localhost:6379

# Microservices
PYTHON_ENGINE_URL=http://localhost:8000

# JWT Secrets for Admin Portal Auth
JWT_SECRET=generate_strong_random_jwt_secret_key_minimum_32_characters_here
JWT_REFRESH_SECRET=generate_strong_random_refresh_secret_key_minimum_32_characters_here

# Seed Admin User Credentials
SEED_ADMIN_EMAIL=admin@surojhankaar.in
SEED_ADMIN_PASSWORD=ChangeThisMasterAdminPassword2026!
SEED_ADMIN_NAME=Sur o Jhankaar Master Admin

# Web Client Environment (Baked during build / runtime)
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
